{
  "name": "nail-exe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "generate-assets": "node scripts/generate-assets.mjs",
    "generate-home-animations": "node scripts/generate-home-animations.mjs",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.17.0"
}
