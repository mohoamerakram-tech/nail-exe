# Copy this file to .env.local for development. Never commit real values.
ADMIN_EMAIL=owner@example.com

# Format: scrypt\$<salt>\$<128-character hex digest>
# Escape the dollar signs so Next.js does not expand them as variables.
ADMIN_PASSWORD_HASH=scrypt\$replace-with-random-salt\$replace-with-scrypt-digest

# Generate at least 32 random bytes and keep this server-only.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: set only to a header overwritten by your trusted reverse proxy.
# Leave blank to use one conservative global login-rate-limit bucket.
ADMIN_CLIENT_IP_HEADER=

# Required for persistent production catalogue data and media.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
